{
  "metadata": {
    "project": "Personal Finance Assistant NLP Dataset",
    "taxonomy_version": "1.4.2",
    "classes": [
      {
        "intent": "add_expense",
        "description": "Logs an outgoing transaction (e.g. food, bills, subscriptions, rides, leisure purchases) with exact monetary values, currencies, vendors, classifications, and dates."
      },
      {
        "intent": "check_balance",
        "description": "Queries funds available on a designated banking ledger (savings, checking, portfolio cache)."
      },
      {
        "intent": "set_budget",
        "description": "Initializes structural caps or target budget indicators for a given spending class."
      },
      {
        "intent": "transfer_funds",
        "description": "Orchestrates structural capital relocations between accounts."
      }
    ],
    "slots": {
      "spend_action": "The primary transaction verb (swiped, spent, paid, shelled out)",
      "query_action": "The financial query verb (audit, get, show me, inspect)",
      "transfer_action": "The capital redirection verb (wire, relocate, send, dispatch)",
      "amount": "The numerical cost or float constant specified",
      "currency": "Standard unit symbol or representation text",
      "merchant": "Corporate, physical, or individual recipient vendor",
      "category": "Classification metadata tag",
      "source_account": "The outgoing register designation",
      "target_account": "The incoming register designation",
      "datetime": "Target time constant frame"
    }
  },
