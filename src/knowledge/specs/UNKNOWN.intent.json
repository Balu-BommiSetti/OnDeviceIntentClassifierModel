{
  "$schema": "../knowledge.schema.json",
  "intent": "UNKNOWN",
  "description": "The safety net. Used when the utterance is gibberish, a greeting, or out of the app's finance scope. The model is trained on these negative examples so it learns an explicit 'I don't understand' region rather than relying only on the confidence threshold. Offline app: no backend service \u2014 the single NONE action means 'respond gracefully, take no action' (BackendActionResolver already short-circuits UNKNOWN to no action + a clarification reply).",
  "supported_actions": [
    "NONE"
  ],
  "required_entities": [],
  "optional_entities": [],
  "backend_route": "NONE",
  "advisory_intent": "UNSUPPORTED",
  "validation": {
    "min_distinct_utterances_per_action": 80
  },
  "utterance_patterns": {
    "NONE": [
      "asdfgh",
      "qwerty lorem ipsum",
