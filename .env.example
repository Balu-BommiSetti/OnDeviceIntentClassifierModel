# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── Pattern-expansion engine (src/knowledge/patterns/expandPatterns.ts) ──────
# Ollama Cloud — used for the initial per-bucket trial runs.
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com"
PATTERN_MODEL="gpt-oss:20b-cloud"

# OpenAI — used for the bulk run across the remaining buckets.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"
